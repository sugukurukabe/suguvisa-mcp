{
  "name": "suguvisa-mcp",
  "version": "0.2.0",
  "description": "特定技能ビザ申請の専門AI — Claude MCP + GPT Actions デュアルプラグイン。申請種別判定、必要書類リスト、期限計算、データ検証、定期報告書を自動生成。",
  "keywords": [
    "mcp",
    "visa",
    "japan",
    "immigration",
    "特定技能",
    "在留資格",
    "行政書士",
    "openai-plugin",
    "gpt-actions",
    "claude-mcp"
  ],
  "author": "Sugukuru Inc. <a_kabe@sugu-kuru.co.jp>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "suguvisa-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "src/data"
  ],
  "scripts": {
    "build": "tsc && shx cp -r src/data dist/",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/server.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/server.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@google-cloud/discoveryengine": "^2.6.0",
    "@google-cloud/documentai": "^9.6.0",
    "@langchain/core": "^1.1.39",
    "@langchain/google-vertexai": "^2.1.26",
    "@langchain/langgraph": "^1.2.6",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@supabase/supabase-js": "^2.101.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.2",
    "xlsx-populate": "^1.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "pdf-parse": "^2.4.5",
    "shx": "^0.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sugukurukabe/suguvisa-mcp.git"
  }
}
