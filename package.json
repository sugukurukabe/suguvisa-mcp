{
  "name": "suguvisa-mcp",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "SuguVisa MCP monorepo — 特定技能ビザ申請自動化 / SSW visa automation / Otomatisasi visa SSW",
  "author": "SugukuruCo., Ltd <a_kabe@sugu-kuru.co.jp>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@suguvisa/mcp-server-app",
    "dev:http": "pnpm --filter @suguvisa/mcp-server-app dev:http",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "eval": "pnpm --filter @suguvisa/evals eval",
    "eval:citation": "pnpm --filter @suguvisa/evals build && node packages/evals/dist/cli.js citation --dataset evals/datasets/citations.jsonl",
    "stripe:seed:dry": "pnpm --filter @suguvisa/billing build && node packages/billing/dist/cli.js seed --dry-run",
    "stripe:seed": "pnpm --filter @suguvisa/billing build && node packages/billing/dist/cli.js seed",
    "stripe:verify": "pnpm --filter @suguvisa/billing build && node packages/billing/dist/cli.js verify",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sugukurukabe/suguvisa-mcp.git"
  }
}
