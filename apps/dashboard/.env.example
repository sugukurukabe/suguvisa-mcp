# SuguVisa Dashboard environment variables
# ダッシュボード環境変数 / Variabel lingkungan dasbor

# Supabase (required for auth)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# MCP Server (required for billing/tenant API calls)
NEXT_PUBLIC_SUGUVISA_API_URL=https://suguvisa-mcp-xxxxxxxxxxx.asia-northeast1.run.app
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Optional: explicit Stripe publishable key (for client-side validation only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
