# SuguVisa MCP Configuration

# --------------------------------------------------------------------------
# [0] OAuth 2.1 (Auth0) — Phase 1
# --------------------------------------------------------------------------
# Auth0 テナントの設定。設定されていない場合は Legacy API Key モードで動作。
AUTH0_DOMAIN=""
AUTH0_AUDIENCE="https://mcp.suguvisa.com"
AUTH0_ISSUER_BASE_URL="https://your-tenant.auth0.com"
AUTH0_MGMT_CLIENT_ID=""
AUTH0_MGMT_CLIENT_SECRET=""

# true にすると OAuth 2.1 と並行して既存 API Key も受け付ける
ALLOW_LEGACY_API_KEY="true"

# --------------------------------------------------------------------------
# [1] API Key (for Local / Dev Mode Bypass)
# --------------------------------------------------------------------------
# If using the SaaS database (Supabase), this key will act as a bypass key
# for local development. If Supabase is NOT set up, this is the ONLY key accepted.
SUGUVISA_API_KEY="your-secret-key-here"

# --------------------------------------------------------------------------
# [2] Supabase (for SaaS Multi-Tenant Authentication & Logging)
# --------------------------------------------------------------------------
# Leave empty for pure local mode.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key"

# --------------------------------------------------------------------------
# [3] Document AI (Google Cloud)
# --------------------------------------------------------------------------
# Requires default credentials or GOOGLE_APPLICATION_CREDENTIALS set
GCP_PROJECT_ID="mcp-service-492010"

# Document AI Processors
DOCUMENT_AI_LOCATION="us"

# Parser ID for standard parsers
DOCUMENT_AI_ID_PARSER_ID="your-id-parser-processor-id"
DOCUMENT_AI_OCR_PROCESSOR_ID="your-ocr-processor-id"
