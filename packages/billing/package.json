    "seed:dry": "node dist/cli.js seed --dry-run",
    "verify": "node dist/cli.js verify"
  },
  "dependencies": {
    "stripe": "^17.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
